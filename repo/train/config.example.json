{
  "run_name": "first-pass",
  "output_dir": "repo/train/runs/first-pass",
  "prompt_audio": "repo/index-tts/examples/prompts/FT0BAE.mp3",
  "services": {
    "asqp": {
      "url": "http://127.0.0.1:8101"
    },
    "tts": {
      "url": "http://127.0.0.1:8102"
    },
    "asr": {
      "url": "http://127.0.0.1:8103"
    },
    "emotion": {
      "url": "http://127.0.0.1:8104"
    },
    "speaker": {
      "url": "http://127.0.0.1:8105"
    },
    "local_emphasis": {
      "url": "http://127.0.0.1:8106"
    },
    "vad": {
      "url": "http://127.0.0.1:8107"
    }
  },
  "reward_weights": {
    "asr": 1.0,
    "emotion": 1.0,
    "speaker": 1.0,
    "local_emphasis": 1.0,
    "global_intensity": 1.0
  },
  "grpo": {
    "group_size": 4,
    "seed": 42,
    "advantage_eps": 1e-06,
    "clip_eps": 0.2,
    "beta": 0.0
  },
  "reward_options": {
    "enabled_rewards": [
      "emotion",
      "local_emphasis",
      "global_intensity"
    ],
    "optional_rewards": [
      "asr",
      "speaker"
    ],
    "global_intensity": {
      "mu_neutral": [0.5, 0.5, 0.5],
      "intensity_thresholds": [0.13, 0.24],
      "intensity_ranges": {
        "weak":   [0.05, 0.20],
        "medium": [0.20, 0.35],
        "strong": [0.35, 0.60]
      },
      "sigma": 0.1,
      "mock_dominance": 0.5
    }
  },
  "wandb": {
    "enabled": true,
    "project": "rl-tts-grpo",
    "name": "first-pass-grpo",
    "mode": "offline"
  }
}
