{
  "run_name": "mock-first-pass",
  "output_dir": "repo/train/runs/mock-first-pass",
  "services": {
    "asqp": {
      "mock": true
    },
    "tts": {
      "mock": true
    },
    "asr": {
      "mock": true
    },
    "emotion": {
      "mock": true
    },
    "speaker": {
      "mock": true
    },
    "local_emphasis": {
      "mock": true
    },
    "vad": {
      "mock": true
    }
  },
  "reward_weights": {
    "asr": 1.0,
    "emotion": 1.0,
    "speaker": 1.0,
    "local_emphasis": 1.0,
    "vad": 1.0,
    "global_intensity": 1.0
  },
  "grpo": {
    "group_size": 4,
    "seed": 42,
    "advantage_eps": 1e-06,
    "clip_eps": 0.2,
    "beta": 0.0
  },
  "reward_options": {
    "enabled_rewards": [
      "emotion",
      "local_emphasis",
      "vad",
      "global_intensity"
    ],
    "optional_rewards": [
      "asr",
      "speaker"
    ],
    "global_intensity": {
      "mu_neutral": [
        0.5,
        0.5,
        0.5
      ],
      "target_range": [
        0.4,
        0.6
      ],
      "sigma": 0.1,
      "mock_dominance": 0.5
    }
  },
  "wandb": {
    "enabled": true,
    "project": "rl-tts-grpo",
    "name": "mock-grpo-smoke",
    "mode": "offline"
  }
}
