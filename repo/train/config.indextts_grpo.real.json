{
  "run_name": "indextts-grpo-run1",
  "output_dir": "repo/train/runs/indextts-grpo-run1",

  "indextts_cfg":       "repo/index-tts/checkpoints/config.yaml",
  "indextts_model_dir": "repo/index-tts/checkpoints",
  "gpt_checkpoint":     "models/IndexTTS_trained/GPTs/trained_200hr_4e_step202000.pth",
  "bpe_model":          "models/IndexTTS_trained/checkpoints/bpe_extended.model",
  "prompt_audio":       "repo/w2v2-how-to/tests/000011_indextts_neutral.wav",

  "data_path": "data/va_train/zho_restaurant_train_alltasks_tagged.jsonl",

  "__HPARAM__limit":        "訓練樣本數上限，null = 用全部資料",
  "limit": null,

  "__HPARAM__updates":      "整個資料集跑幾輪（epoch 數）",
  "updates": 1,

  "__HPARAM__group_size":   "每個 prompt 取樣幾個候選（GRPO rollout 群大小，越大 variance 估計越準但 VRAM 倍增）",
  "group_size": 4,

  "__HPARAM__max_mel_tokens": "每次取樣最多生成幾個 mel token（限制輸出長度）",
  "max_mel_tokens": 256,

  "__HPARAM__temperature":  "取樣溫度（越高越多樣，越低越保守）",
  "temperature": 0.85,

  "__HPARAM__top_k":        "top-k 取樣（0 = 不限制）",
  "top_k": 50,

  "__HPARAM__top_p":        "nucleus 取樣（1.0 = 不限制）",
  "top_p": 0.9,

  "__HPARAM__learning_rate": "AdamW 學習率",
  "learning_rate": 1e-6,

  "grpo": {
    "__HPARAM__clip_eps": "PPO surrogate loss clip 範圍（標準值 0.2）",
    "clip_eps": 0.2,
    "__HPARAM__beta":     "KL 懲罰係數（0.0 = 純 GRPO，>0 = 加入 KL 正則化）",
    "beta": 0.1
  },

  "services": {
    "asqp":          { "mock": true },
    "tts":           { "mock": true },
    "asr":           { "mock": true },
    "emotion":       { "url": "http://127.0.0.1:8104" },
    "speaker":       { "mock": true },
    "local_emphasis":{ "url": "http://127.0.0.1:8106" },
    "alignment":     { "url": "http://127.0.0.1:8108" },
    "vad":           { "url": "http://127.0.0.1:8107" }
  },

  "reward_options": {
    "__HPARAM__enabled_rewards": "要計算哪些 reward",
    "enabled_rewards": ["emotion", "global_intensity", "local_emphasis"],
    "global_intensity": {
      "__HPARAM__mu_neutral":           "VAD 空間的「中性」中心點（需用真實中性語音校準）",
      "mu_neutral": [0.5, 0.5, 0.5],
      "__HPARAM__intensity_thresholds": "target VA 距離的 weak/medium/strong 切點 [weak_max, medium_max]",
      "intensity_thresholds": [0.13, 0.24],
      "__HPARAM__intensity_ranges":     "各強度等級對應的 3D VAD 距離目標區間",
      "intensity_ranges": {
        "weak":   [0.05, 0.20],
        "medium": [0.20, 0.35],
        "strong": [0.35, 0.60]
      },
      "__HPARAM__sigma":                "Gaussian reward 的寬度",
      "sigma": 0.1,
      "mock_dominance": 0.5
    }
  },

  "__HPARAM__reward_weights": "各 reward 的加權比重（總 reward = 加權和）",
  "reward_weights": {
    "asr":              0.5,
    "emotion":          1.0,
    "global_intensity": 1.0,
    "local_emphasis":   1.0,
    "speaker":          0.3
  },

  "keep_last_checkpoints": 5,

  "wandb": {
    "enabled": true,
    "project": "rl-tts-grpo",
    "name": "indextts-grpo-run1",
    "mode": "online"
  }
}
